<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.shape.Rectangle?>

<VBox xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="sk.ukf.demo.MainController">
   <children>


      <Pane fx:id="canvas" prefWidth="900.0" prefHeight="500.0" maxWidth="900.0" maxHeight="500.0"
            style="-fx-background-color: #232D46;">
         <clip>
            <Rectangle width="900.0" height="500.0" />
         </clip>
      </Pane>

      <HBox spacing="10.0">
         <padding>
            <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
         </padding>
         <children>
            <Button text="Pridať oblak" onAction="#addCloud" />
            <Button text="Pridať kvapku" onAction="#addRaindrop" />
            <Button text="Pridať vločku" onAction="#addSnowflake" />
            <Button fx:id="btnStop" text="Zastaviť dážď" onAction="#toggleRain" />
            <Button text="Oblaky na modro" onAction="#makeCloudsBlue" />
            <Button text="Posunúť o 20 px doľava" onAction="#shiftLeft" />
         </children>
      </HBox>

   </children>
</VBox>
